<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_beauty_cabin_tree" model="ir.ui.view">
        <field name="name">fd.beauty.cabin.tree</field>
        <field name="model">fd.beauty.cabin</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="booking_resource_id"/>
                <field name="capacity"/>
                <field name="cleaning_time"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_beauty_cabin_form" model="ir.ui.view">
        <field name="name">fd.beauty.cabin.form</field>
        <field name="model">fd.beauty.cabin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="code"/>
                            <field name="booking_resource_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="cleaning_time"/>
                            <field name="color"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_beauty_cabins" model="ir.actions.act_window">
        <field name="name">Beauty Cabins</field>
        <field name="res_model">fd.beauty.cabin</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
