<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LISTA -->

    <record id="view_beauty_service_tree" model="ir.ui.view">
        <field name="name">fd.beauty.service.tree</field>
        <field name="model">fd.beauty.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="duration"/>
                <field name="list_price"/>
                <field name="allow_online"/>
                <field name="booking_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- FORMULARIO -->

    <record id="view_beauty_service_form" model="ir.ui.view">
        <field name="name">fd.beauty.service.form</field>
        <field name="model">fd.beauty.service</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>

                            <field name="code"/>

                            <field name="category_id"/>

                            <field name="booking_template_id"/>

                            <field name="active"/>

                        </group>

                        <group>

                            <field name="duration"/>

                            <field name="preparation_time"/>

                            <field name="cleanup_time"/>

                            <field name="list_price"/>

                            <field name="allow_online"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Professionals">

                            <field name="employee_service_ids"/>

                        </page>

                        <page string="Products">

                            <field name="product_ids"/>

                        </page>

                        <page string="Cabins">
                            <field name="cabin_ids" widget="many2many_tags"/>
                        </page>

                        <page string="Description">

                            <field name="description"/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <!-- SEARCH -->

    <record id="view_beauty_service_search" model="ir.ui.view">
        <field name="name">fd.beauty.service.search</field>
        <field name="model">fd.beauty.service</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="category_id"/>

                <filter name="online"
                        string="Online"
                        domain="[('allow_online','=',True)]"/>

                <filter name="active"
                        string="Active"
                        domain="[('active','=',True)]"/>

            </search>

        </field>
    </record>

    <!-- ACTION -->

    <record id="action_beauty_services" model="ir.actions.act_window">
        <field name="name">Beauty Services</field>
        <field name="res_model">fd.beauty.service</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
