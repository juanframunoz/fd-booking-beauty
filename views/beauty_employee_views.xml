<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_beauty_employee_tree" model="ir.ui.view">
        <field name="name">fd.beauty.employee.tree</field>
        <field name="model">fd.beauty.employee</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="resource_id"/>
                <field name="service_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_beauty_employee_form" model="ir.ui.view">
        <field name="name">fd.beauty.employee.form</field>
        <field name="model">fd.beauty.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="resource_id"/>
                        <field name="color"/>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="employee_service_ids">
                                <tree editable="bottom">
                                    <field name="service_id"/>
                                    <field name="duration"/>
                                    <field name="price"/>
                                    <field name="priority"/>
                                    <field name="allow_online"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_beauty_employees" model="ir.actions.act_window">
        <field name="name">Beauty Professionals</field>
        <field name="res_model">fd.beauty.employee</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
