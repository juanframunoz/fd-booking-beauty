<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_beauty_booking_wizard_form" model="ir.ui.view">
        <field name="name">fd.beauty.booking.wizard.form</field>
        <field name="model">fd.beauty.booking.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Beauty Booking">
                <group>
                    <field name="service_id"/>
                    <field name="employee_id"/>
                    <field name="booking_date"/>
                    <field name="booking_time"/>
                    <field name="partner_id"/>
                </group>
                <group>
                    <field name="duration"/>
                    <field name="price"/>
                </group>
                <footer>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_beauty_booking_wizard" model="ir.actions.act_window">
        <field name="name">Create Beauty Booking</field>
        <field name="res_model">fd.beauty.booking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
